---
import { formatStarRating } from '../lib/ratings';

interface Props {
    rating: number | null;
}

const { rating } = Astro.props;
---

<div class="flex items-center mb-3">
    {rating !== null ? (
        <span class="bg-blue-500/20 text-blue-400 text-sm px-3 py-1 rounded-full" data-testid="game-rating">
            <span class="text-yellow-400">{formatStarRating(rating)}</span>
        </span>
    ) : (
        <span class="text-sm text-slate-400" data-testid="game-rating">Not yet rated</span>
    )}
</div>
